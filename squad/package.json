{
  "name": "squad",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Squad: player-owned Mineflayer bots ordered by LLM-written scripts (docs/29). One Node process under a supervisor.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/supervisor.ts squad.json",
    "start:direct": "tsx src/main.ts squad.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "live-test": "tsx live-tests/run.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "bench:load": "tsx bench/load.ts",
    "bench:micro": "tsx bench/micro.ts",
    "bench:profiles": "tsx bench/profile-summary.ts",
    "bench:report": "tsx bench/report.ts",
    "bench:compare": "tsx bench/compare.ts",
    "bench:callers": "tsx bench/callers.ts",
    "bench:repro-tasks-spin": "tsx bench/repro-tasks-spin.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.5",
    "better-sqlite3": "^12.2.0",
    "minecrafthawkeye": "^1.3.9",
    "mineflayer": "^4.37.1",
    "mineflayer-armor-manager": "^2.0.1",
    "mineflayer-auto-eat": "^5.0.3",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-pvp": "^1.3.2",
    "mineflayer-tool": "^1.2.0",
    "protodef": "^1.19.0",
    "typescript": "^5.7.2",
    "vec3": "^0.1.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.18.1"
  }
}
