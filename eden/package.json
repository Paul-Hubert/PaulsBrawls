{
  "name": "eden",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Eden — from-scratch rewrite of the AI Village (God + 10 villagers over one shared, God-judged skill library). One Node process.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage \"tests/**/*.test.ts\"",
    "rebuild-stats": "tsx src/cli/rebuild-stats.ts",
    "eval": "tsx eval/run.ts",
    "check": "npm run lint && npm run typecheck && npm run depcruise && npm test"
  },
  "dependencies": {
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.5",
    "better-sqlite3": "^12.2.0",
    "mineflayer": "^4.37.1",
    "mineflayer-armor-manager": "^2.0.1",
    "mineflayer-auto-eat": "^5.0.3",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-pvp": "^1.3.2",
    "mineflayer-tool": "^1.2.0",
    "strip-json-comments": "^5.0.1",
    "ulid": "^3.0.1",
    "vec3": "^0.1.10",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "dependency-cruiser": "^16.8.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
