diff --git a/node_modules/mineflayer-pathfinder/lib/tick.js b/node_modules/mineflayer-pathfinder/lib/tick.js
new file mode 100644
index 0000000..f13eaac
--- /dev/null
+++ b/node_modules/mineflayer-pathfinder/lib/tick.js
@@ -0,0 +1,34 @@
+// Short-lived caches of the look-ahead (physics.js) and of A* (movements.js) need to know when a bot's tick, or the
+// blocks around it, may have changed. Every Physics and Movements of a bot shares one clock, with one set of listeners
+// per bot: pvp, collectblock and user code each make their own Movements, so a listener per instance would pile up.
+const clocks = new WeakMap()
+
+/**
+ * The clock of a bot, or null when the bot cannot emit events (then nothing is cached).
+ * @param {import('mineflayer').Bot} bot
+ * @returns {{ tick: number, blocks: number } | null} `tick` counts physics ticks; `blocks` also moves on every block
+ * update and chunk (un)load, so a cache keyed on it never serves a block that changed.
+ */
+function getClock (bot) {
+  let clock = clocks.get(bot)
+  if (clock !== undefined) return clock
+  if (typeof bot.on !== 'function') {
+    clocks.set(bot, null)
+    return null
+  }
+  clock = { tick: 0, blocks: 0 }
+  clocks.set(bot, clock)
+  // Prepended, so that every physicsTick listener (the pathfinder's own, registered earlier) already sees the new tick.
+  const listen = typeof bot.prependListener === 'function' ? bot.prependListener.bind(bot) : bot.on.bind(bot)
+  listen('physicsTick', () => {
+    clock.tick++
+    clock.blocks++
+  })
+  const blocksChanged = () => { clock.blocks++ }
+  listen('blockUpdate', blocksChanged)
+  listen('chunkColumnLoad', blocksChanged)
+  listen('chunkColumnUnload', blocksChanged)
+  return clock
+}
+
+module.exports = { getClock }
