{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5",
  "share": "disabled",
  "autoupdate": false,
  "permission": { "*": "deny" },
  "mcp": {
    "god": {
      "type": "remote",
      "url": "http://127.0.0.1:8771/mcp/god",
      "headers": { "Authorization": "Bearer {env:PAULSBRAWLS_MCP_TOKEN}" },
      "oauth": false,
      "enabled": true
    },
    "builder": {
      "type": "remote",
      "url": "http://127.0.0.1:8771/mcp/builder",
      "headers": { "Authorization": "Bearer {env:PAULSBRAWLS_MCP_TOKEN}" },
      "oauth": false,
      "enabled": true
    }
  },
  "agent": {
    "god": {
      "description": "Dieu : répond aux prières des joueurs de Minecraft et agit sur le monde par le serveur MCP god.",
      "mode": "primary",
      "prompt": "{file:./prompts/god.md}",
      "permission": { "*": "deny", "god_*": "allow" }
    },
    "builder": {
      "description": "Planifie une construction Minecraft et la confie à des sous-bâtisseurs.",
      "mode": "primary",
      "prompt": "{file:./prompts/builder.md}",
      "permission": { "*": "deny", "builder_*": "allow", "task": { "*": "deny", "sub-builder": "allow" } }
    },
    "sub-builder": {
      "description": "Construit UNE structure Minecraft à une ancre donnée, par le serveur MCP builder.",
      "mode": "subagent",
      "prompt": "{file:./prompts/sub-builder.md}",
      "permission": { "*": "deny", "builder_*": "allow" }
    }
  }
}
