# Copy to api-keys.env (gitignored) and fill in your keys.
# Loaded by the host (src/main.ts) AND the live-test harness (live-tests/run*.ts) before booting the LLM.
# Existing process env vars take precedence (CI/pm2 can export keys directly — pm2 needs --update-env).
# The key for the configured provider's apiKeyEnv (see providers.json) MUST be present here or in the
# environment, or the host fails loud at boot (R56) — it does NOT fall back to OPENAI_API_KEY.

DEEPSEEK_API_KEY=sk-your-deepseek-key-here
OPENAI_API_KEY=sk-your-openai-key-here
