{
  "name": "minecraft-mcp-server",
  "version": "2.0.4",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "minecraft-mcp-server": "dist/main.js"
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "nodeArguments": [
      "--import=tsx"
    ]
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "bridge": "tsx src/bridge/main.ts",
    "bridge:start": "node dist/bridge/main.js",
    "unified": "tsx src/unified/main.ts",
    "unified:start": "node dist/unified/main.js",
    "village": "tsx src/village/main.ts",
    "village:start": "node dist/village/main.js",
    "eval": "tsx eval/orchestrator.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "start": "node dist/main.js",
    "test": "ava",
    "lint": "eslint \"{src,tests,eval}/**/*.ts\"",
    "lint:fix": "eslint \"{src,tests,eval}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.4",
    "astring": "^1.9.0",
    "minecraft-data": "^3.105.0",
    "mineflayer": "^4.35.0",
    "mineflayer-armor-manager": "^2.0.1",
    "mineflayer-auto-eat": "^5.0.3",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.2",
    "mineflayer-pvp": "^1.3.2",
    "mineflayer-tool": "^1.2.0",
    "typescript": "^5.9.3",
    "vec3": "^0.1.8",
    "yargs": "^18.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ava/typescript": "^6.0.0",
    "@types/node": "^25.9.1",
    "@types/sinon": "^21.0.0",
    "@types/vec3": "^0.1.4",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.56.1",
    "ava": "^6.4.1",
    "eslint": "^9.39.2",
    "eslint-plugin-ava": "^15.1.0",
    "globals": "^17.3.0",
    "rcon-client": "^4.2.5",
    "sinon": "^21.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
