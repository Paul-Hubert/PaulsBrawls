{
  // Role-default subscriptions (04 §Subscriptions) — seeded into each villager AT FIRST BOOT only.
  // Policy as DATA (P5): each entry is a declarative "when X (filtered), do Y" reflex, no code. `Y` is
  // either a free zero-token skill run ({ kind:'skill', name, args }) or a brain wake-up
  // ({ kind:'deliberate', hint, priority? }). Filters are AND-composed declarative clauses
  // (within/entityKind/nameMatches/timeOfDay/healthBelow/foodBelow/notWhileRunning). ArgTemplate
  // "$event.*" paths in a skill handler's args resolve from the event at fire time.
  //
  // "everyone" seeds every villager regardless of role; a named role block adds to it. A role spec that
  // duplicates an everyone spec (same event + handler kind) is skipped (no double-reflex).
  // Edit freely — re-seeding only happens on a villager's FIRST boot (delete its
  // .eden-data/subscriptions/<name>.json to re-adopt these).

  "everyone": [
    // Took damage → flee to safety (a free reflex). notWhileRunning suppresses it while already fleeing.
    { "on": "hurt", "filter": { "notWhileRunning": ["flee-to-safety"] }, "handler": { "kind": "skill", "name": "flee-to-safety", "args": {} }, "cooldownMs": 3000 },
    // Health crossed low (hysteresis-edged emitter) → think about what to do (eat, retreat, call for help).
    { "on": "health-low", "handler": { "kind": "deliberate", "hint": "ta santé est basse — décide quoi faire (manger, fuir, demander de l'aide)", "priority": "interrupt" } },
    // A player speaks within earshot → deliberate (they may want to trade or talk).
    { "on": "player-chat", "filter": { "within": 8 }, "handler": { "kind": "deliberate", "hint": "un joueur te parle — réponds en français", "priority": "normal" }, "cooldownMs": 2000 },
    // Something landed in your inbox (a directive/critique/tell from God) → deliberate.
    { "on": "inbox", "handler": { "kind": "deliberate", "hint": "tu as reçu un message de Dieu — lis-le et agis", "priority": "normal" } },
    // Night fell → go home (a free reflex) so villagers don't wander into the dark.
    { "on": "night-falls", "handler": { "kind": "skill", "name": "go-home", "args": {} } }
  ],

  "guard": [
    // Took damage → FIGHT, don't flee (D-15). This OVERRIDES everyone's hurt→flee-to-safety for guards
    // (a role spec on an event replaces the everyone spec on that event). Zero-token: defend-self finds
    // the nearest hostile and attacks it the instant the hit lands — the sub-second reflex a guard needs
    // so it doesn't stand passive while the LLM authors a combat skill. notWhileRunning keeps a guard
    // mid-fight from restarting on every hit; the short cooldown is a backstop against a hit burst.
    { "on": "hurt", "filter": { "notWhileRunning": ["defend-self"] }, "handler": { "kind": "skill", "name": "defend-self", "args": {} }, "cooldownMs": 1000 },
    // A hostile entered perception → deliberate at high priority (decide: fight, warn, retreat).
    { "on": "entity-spotted", "filter": { "entityKind": "hostile", "within": 16 }, "handler": { "kind": "deliberate", "hint": "un ennemi est repéré — décide d'attaquer, d'alerter ou de te replier", "priority": "interrupt" }, "cooldownMs": 5000 }
  ],

  "archer": [
    // Took damage despite the high ground → fight back at the nearest hostile (zero-token backstop). Overrides
    // everyone's hurt→flee so the archer does not leap off its tower; normally an elevated archer is never hit.
    { "on": "hurt", "filter": { "notWhileRunning": ["defend-self"] }, "handler": { "kind": "skill", "name": "defend-self", "args": {} }, "cooldownMs": 1000 },
    // A hostile entered perception (≤24 — the poll's full range) → deliberate at top priority: shoot it from
    // the high spot with the bow (shoot-mob) BEFORE it can close. This IS "detect before they attack".
    { "on": "entity-spotted", "filter": { "entityKind": "hostile", "within": 24 }, "handler": { "kind": "deliberate", "hint": "un ennemi hostile est repéré — depuis ton point haut, abats-le à l'arc (run_skill shoot-mob) AVANT qu'il ne t'atteigne, sans descendre de la tour", "priority": "interrupt" }, "cooldownMs": 4000 }
  ],

  "swordsman": [
    // Took damage → fight the nearest hostile (zero-token backstop, overrides everyone's hurt→flee — D-15).
    { "on": "hurt", "filter": { "notWhileRunning": ["defend-self"] }, "handler": { "kind": "skill", "name": "defend-self", "args": {} }, "cooldownMs": 1000 },
    // A hostile entered perception (≤20) → deliberate: intercept and cut it down (kill-mob), or soften it with
    // the bow first while it is still far (shoot-mob) — kill it BEFORE it lands a hit. "Detect before attack."
    { "on": "entity-spotted", "filter": { "entityKind": "hostile", "within": 20 }, "handler": { "kind": "deliberate", "hint": "un ennemi hostile est repéré — intercepte-le et abats-le (run_skill kill-mob, ou shoot-mob s'il est encore loin) AVANT qu'il ne te touche", "priority": "interrupt" }, "cooldownMs": 4000 }
  ],

  "farmer": [
    // A new day began → harvest the home field (a free reflex; the skill reads the farmer's home anchor).
    { "on": "new-day", "handler": { "kind": "skill", "name": "harvest-field", "args": {} } }
  ],

  "miner": [
    // A new day began → think about the day's mining plan.
    { "on": "new-day", "handler": { "kind": "deliberate", "hint": "nouveau jour — planifie ta session de minage", "priority": "background" } }
  ]
}
