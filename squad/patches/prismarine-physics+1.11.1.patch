+// A PlayerState is built on every physics tick of every bot and in every pathfinder look-ahead. minecraft-data
+// re-parses the version string on each call, so its result is kept per version.
+const mcDataByVersion = new Map()
+function getMcData (version) {
+  let mcData = mcDataByVersion.get(version)
+  if (mcData === undefined) {
+    mcData = loadMcData(version)
+    mcDataByVersion.set(version, mcData)
+  }
+  return mcData
+}
 
